# Copy to .env and adjust. Local DB: docker compose up -d (repo root), then migrate.

NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
WEB_URL=http://localhost:3000

# Matches docker-compose.yml (postgres / postgres / quizflow on localhost:5432)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quizflow

JWT_ACCESS_SECRET=change-me-use-at-least-32-chars-secret-one
JWT_REFRESH_SECRET=change-me-use-at-least-32-chars-secret-two
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

OPENAI_API_KEY=sk-replace-with-your-openai-key

STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_secret
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_webhook_secret
STRIPE_PRO_PRICE_ID=price_replace_with_pro_price_id

MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

CORS_ORIGIN=http://localhost:3000
