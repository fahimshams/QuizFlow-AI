# QuizFlow AI — environment template
# Copy sections into:
#   apps/api/.env   (all variables validated in apps/api/src/config/env.ts)
#   apps/web/.env.local   (NEXT_PUBLIC_* only)
#
# Local PostgreSQL: from repo root run `pnpm db:up` (see docker-compose.yml), then
# `pnpm db:migrate` with DATABASE_URL below or use apps/api/.env.example.

# -----------------------------------------------------------------------------
# API (apps/api) — required; validated at startup
# -----------------------------------------------------------------------------

NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
WEB_URL=http://localhost:3000

# PostgreSQL (Prisma) — local example; Azure: postgres://USER:PASSWORD@HOST.postgres.database.azure.com:5432/DB?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quizflow

# JWT — use strong random strings in production (min 32 chars each)
JWT_ACCESS_SECRET=change-me-use-at-least-32-chars-secret-one
JWT_REFRESH_SECRET=change-me-use-at-least-32-chars-secret-two
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# OpenAI (must start with sk-)
OPENAI_API_KEY=sk-replace-with-your-openai-key

# Stripe (secret key must start with sk_; webhook with whsec_)
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_secret
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_webhook_secret
STRIPE_PRO_PRICE_ID=price_replace_with_pro_price_id

# Uploads
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# Rate limiting (optional defaults shown)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS — browser origin for the Next.js app
CORS_ORIGIN=http://localhost:3000

# -----------------------------------------------------------------------------
# Web (apps/web) — NEXT_PUBLIC_* exposed to the browser
# -----------------------------------------------------------------------------

NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_your_publishable_key
